From c75580f29ed5a6fec080924e2e054f18741912b9 Mon Sep 17 00:00:00 2001
From: Thomas Guillem <thomas@gllm.fr>
Date: Sun, 26 Jul 2026 12:36:17 +0000
Subject: [PATCH 14/15] vulkan: don't use KHR_coopmat on Mali

Mali advertises the extension but has no matrix hardware, so the coopmat
pipelines are emulated and slower than the standard path. On a Mali-G715,
q8_0 MUL_MAT goes 29.9 -> 208 GFLOPS/s (whisper small-q8_0, 152s -> 90s).

Gated on driverID: ARM's 0x13b5 is not in VkVendorId, and Samsung Xclipse
is RDNA3-based so it must keep coopmat.
---
 ggml/src/ggml-vulkan/ggml-vulkan.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-vulkan/ggml-vulkan.cpp b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
index 41889d55..00b912f5 100644
--- a/ggml/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/ggml/src/ggml-vulkan/ggml-vulkan.cpp
@@ -18105,7 +18105,8 @@ static bool ggml_vk_khr_cooperative_matrix_support(const vk::PhysicalDevicePrope
         }
         return true;
     default:
-        return true;
+        // Mali has no matrix hardware: its emulated coopmat path is 7x slower
+        return driver_props.driverID != vk::DriverId::eArmProprietary;
     }
 }
 
-- 
2.47.3


From 6d94b698e29d0c4e2e086006ad262479d649b4e2 Mon Sep 17 00:00:00 2001
From: Thomas Guillem <thomas@gllm.fr>
Date: Thu, 30 Jul 2026 11:19:48 +0000
Subject: [PATCH 15/15] ggml-cpu: tighten ARM variant selection

Android selects CPU modules from HWCAP at runtime. Using armv8.2-a as
the base for the FP16 and DotProd variant also permits unrelated LSE and
RDM instructions that those feature checks do not cover.

Keep the base at armv8-a and enable only fp16 and dotprod. Require both
FPHP and ASIMDHP when scoring FP16 vector arithmetic, since ASIMDHP is
needed by half-precision SIMD instructions.

Let callers select an explicit variant list so Android packages can
include only the baseline and fp16-dotprod modules.
---
 ggml/CMakeLists.txt                      |  1 +
 ggml/src/CMakeLists.txt                  | 11 +++++++++++
 ggml/src/ggml-cpu/CMakeLists.txt         | 14 ++++++--------
 ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp |  2 +-
 4 files changed, 19 insertions(+), 9 deletions(-)

diff --git a/ggml/CMakeLists.txt b/ggml/CMakeLists.txt
index 0470e3e2..217dbc01 100644
--- a/ggml/CMakeLists.txt
+++ b/ggml/CMakeLists.txt
@@ -181,6 +181,7 @@ option(GGML_XTHEADVECTOR     "ggml: enable xtheadvector"      OFF)
 option(GGML_VXE              "ggml: enable vxe"               ${GGML_NATIVE})
 
 option(GGML_CPU_ALL_VARIANTS "ggml: build all variants of the CPU backend (requires GGML_BACKEND_DL)" OFF)
+set(GGML_CPU_VARIANTS        "" CACHE STRING "ggml: CPU backend variants to build")
 set(GGML_CPU_ARM_ARCH        "" CACHE STRING "ggml: CPU architecture for ARM")
 set(GGML_CPU_POWERPC_CPUTYPE "" CACHE STRING "ggml: CPU type for PowerPC")
 
diff --git a/ggml/src/CMakeLists.txt b/ggml/src/CMakeLists.txt
index 89e5180d..9c8f2aef 100644
--- a/ggml/src/CMakeLists.txt
+++ b/ggml/src/CMakeLists.txt
@@ -323,6 +323,13 @@ function(ggml_add_backend backend)
 endfunction()
 
 function(ggml_add_cpu_backend_variant tag_name)
+    if (GGML_CPU_VARIANTS)
+        list(FIND GGML_CPU_VARIANTS ${tag_name} variant_index)
+        if (variant_index EQUAL -1)
+            return()
+        endif()
+    endif()
+
     set(GGML_CPU_TAG_NAME ${tag_name})
     # other: OPENMP LLAMAFILE CPU_HBM
     if (GGML_SYSTEM_ARCH STREQUAL "x86")
@@ -415,6 +422,10 @@ if (GGML_CPU_ALL_VARIANTS)
             ggml_add_cpu_backend_variant(armv9.2_2    DOTPROD FP16_VECTOR_ARITHMETIC SVE MATMUL_INT8 SVE2 SME)
         elseif (CMAKE_SYSTEM_NAME MATCHES "Android")
             # Android-specific backends with SoC-compatible feature sets
+            if (GGML_CPU_VARIANTS)
+                ggml_add_cpu_backend_variant(baseline)
+                ggml_add_cpu_backend_variant(fp16-dotprod DOTPROD FP16_VECTOR_ARITHMETIC)
+            endif()
             ggml_add_cpu_backend_variant(android_armv8.0_1)
             ggml_add_cpu_backend_variant(android_armv8.2_1    DOTPROD)
             ggml_add_cpu_backend_variant(android_armv8.2_2    DOTPROD FP16_VECTOR_ARITHMETIC)
diff --git a/ggml/src/ggml-cpu/CMakeLists.txt b/ggml/src/ggml-cpu/CMakeLists.txt
index f7c557af..8359dbf6 100644
--- a/ggml/src/ggml-cpu/CMakeLists.txt
+++ b/ggml/src/ggml-cpu/CMakeLists.txt
@@ -174,18 +174,16 @@ function(ggml_add_cpu_backend_variant_impl tag_name)
                     set(ARCH_TAGS "")
                     set(ARCH_DEFINITIONS "")
 
-                    # When a feature is selected, bump the MCPU to the first
-                    # version that supported it
-                    if (GGML_INTERNAL_DOTPROD)
-                        set(ARM_MCPU "armv8.2-a")
-                        set(ARCH_TAGS "${ARCH_TAGS}+dotprod")
-                        list(APPEND ARCH_DEFINITIONS GGML_USE_DOTPROD)
-                    endif()
+                    # Keep optional extensions on the narrowest architectural
+                    # base so unrelated instructions are not enabled.
                     if (GGML_INTERNAL_FP16_VECTOR_ARITHMETIC)
-                        set(ARM_MCPU "armv8.2-a")
                         set(ARCH_TAGS "${ARCH_TAGS}+fp16")
                         list(APPEND ARCH_DEFINITIONS GGML_USE_FP16_VECTOR_ARITHMETIC)
                     endif()
+                    if (GGML_INTERNAL_DOTPROD)
+                        set(ARCH_TAGS "${ARCH_TAGS}+dotprod")
+                        list(APPEND ARCH_DEFINITIONS GGML_USE_DOTPROD)
+                    endif()
                     if (GGML_INTERNAL_SVE)
                         set(ARM_MCPU "armv8.2-a")
                         set(ARCH_TAGS "${ARCH_TAGS}+sve")
diff --git a/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp b/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp
index c460c549..f5d3513b 100644
--- a/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp
+++ b/ggml/src/ggml-cpu/arch/arm/cpu-feats.cpp
@@ -35,7 +35,7 @@ struct aarch64_features {
         uint32_t hwcap2 = getauxval(AT_HWCAP2);
 
         has_dotprod = !!(hwcap & HWCAP_ASIMDDP);
-        has_fp16_va = !!(hwcap & HWCAP_FPHP);
+        has_fp16_va = !!(hwcap & HWCAP_FPHP) && !!(hwcap & HWCAP_ASIMDHP);
         has_sve     = !!(hwcap & HWCAP_SVE);
         has_sve2    = !!(hwcap2 & HWCAP2_SVE2);
         has_i8mm    = !!(hwcap2 & HWCAP2_I8MM);
-- 
2.47.3

